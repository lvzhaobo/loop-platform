{
  "language": "python",
  "module": "app.py",
  "banned_patterns": ["eval(", "exec(", "os.system", "subprocess"],
  "max_lines": 200,
  "data_file": "data/products.json",
  "min_items": 8,
  "id_sequential_from": 1,
  "field_rules": {
    "title": {"type": "string", "max_len": 40},
    "price": {"type": "number", "gt": 0},
    "sales": {"type": "int", "gte": 0},
    "desc": {"type": "string", "min_len": 30}
  },
  "markers": {
    "templates/list.html": ["product-card"],
    "templates/detail.html": ["btn-cart", "btn-buy"]
  },
  "loop": {
    "max_iterations": 5,
    "max_cost": 100,
    "cost_per_attempt": 20
  }
}
