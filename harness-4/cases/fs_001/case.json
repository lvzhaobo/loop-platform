{
  "name": "fs_001",
  "title": "在线学习平台番茄时钟模块",
  "data_file": "data/tomato_clocks.json",
  "loader_function": "load_tomato_clocks",
  "route_functions": [
    "tomato_clock_list",
    "tomato_clock_detail",
    "api_tomato_clocks",
    "api_tomato_clock_detail"
  ],
  "needs_images": true,
  "image_field": "cover_image",
  "extra_required_files": [
    "data/tomato_clocks.json"
  ],
  "entity": "tomato_clock",
  "min_items": 8,
  "required_fields": [
    "id",
    "title",
    "duration_minutes",
    "description",
    "color_hex",
    "created_at",
    "is_active"
  ],
  "numeric_fields": {
    "duration_minutes": "int",
    "is_active": "int"
  },
  "field_rules": {
    "id": {
      "type": "int",
      "sequential_from": 1
    },
    "title": {
      "type": "string",
      "max_len": 100
    },
    "cover_image": {
      "type": "string",
      "max_len": 500
    },
    "duration_minutes": {
      "type": "int",
      "gt": 0,
      "lte": 60
    },
    "description": {
      "type": "string",
      "min_len": 10,
      "max_len": 2000
    },
    "color_hex": {
      "type": "string",
      "max_len": 7
    },
    "created_at": {
      "type": "string",
      "max_len": 20
    },
    "is_active": {
      "type": "int",
      "gte": 0,
      "lte": 1
    }
  },
  "routes": {
    "list": "/",
    "detail_sample": "/tomato_clock/1",
    "api_list": "/api/tomato_clocks",
    "api_detail_ok": "/api/tomato_clocks/1",
    "api_detail_missing": "/api/tomato_clocks/9999"
  },
  "list_marker": "tomato-card",
  "detail_markers": [
    "btn-tomato",
    "tomato-detail-body"
  ],
  "colors": [
    "#e74c3c",
    "#ffffff"
  ],
  "list_card_children": [
    "tomato-card-image",
    "tomato-card-title",
    "tomato-card-duration",
    "tomato-card-status"
  ]
}
