{
  "harness_version": "4.0.0",
  "tech": {
    "language": "python",
    "framework": "flask",
    "entry": "app.py",
    "start_cmd": ["python", "app.py"],
    "port_env": "PORT",
    "default_port": 5000
  },
  "base_required_files": [
    "app.py",
    "requirements.txt",
    "README.md",
    "templates/base.html",
    "templates/list.html",
    "templates/detail.html",
    "static/css/style.css",
    "static/js/main.js",
    "tests/test_app.py"
  ],
  "banned_deps": [
    "django",
    "sqlalchemy",
    "flask-sqlalchemy",
    "fastapi",
    "vue",
    "react",
    "jquery",
    "bootstrap",
    "pytest"
  ],
  "banned_code_patterns": [
    "eval(",
    "exec(",
    "os.system(",
    "subprocess.",
    "__import__(",
    "pickle.load"
  ],
  "max_inline_style": 2,
  "cases": ["ecommerce", "blog", "education"],
  "run_cases": ["education"]
}
