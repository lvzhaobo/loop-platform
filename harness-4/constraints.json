{
  "banned_code_patterns": [
    "eval(",
    "exec(",
    "os.system(",
    "subprocess.",
    "__import__(",
    "pickle.load"
  ],
  "banned_deps": [
    "django",
    "sqlalchemy",
    "flask-sqlalchemy",
    "fastapi",
    "vue",
    "react",
    "jquery",
    "bootstrap",
    "pytest"
  ],
  "base_required_files": [
    "app.py",
    "requirements.txt",
    "README.md",
    "templates/base.html",
    "templates/list.html",
    "templates/detail.html",
    "static/css/style.css",
    "static/js/main.js",
    "tests/test_app.py"
  ],
  "cases": [
    "blog",
    "ecommerce",
    "education",
    "fs_001",
    "fs_002",
    "jobs",
    "recipe"
  ],
  "harness_version": "4.0.0",
  "max_inline_style": 3,
  "run_cases": [
    "education"
  ],
  "tech": {
    "default_port": 5000,
    "entry": "app.py",
    "framework": "flask",
    "language": "python",
    "port_env": "PORT",
    "start_cmd": [
      "python",
      "app.py"
    ]
  }
}
