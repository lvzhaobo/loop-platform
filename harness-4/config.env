# Harness-4 运行配置(确定性 + 用例集 + 开关)。可被已导出的环境变量覆盖。

# ---- 生成模型(真实模式) ----
export DEEPSEEK_MODEL="${DEEPSEEK_MODEL:-deepseek-chat}"
export DEEPSEEK_BASE_URL="${DEEPSEEK_BASE_URL:-https://api.deepseek.com}"

# ---- 确定性(见 README §确定性) ----
export HARNESS_TEMPERATURE="${HARNESS_TEMPERATURE:-0}"
export HARNESS_SEED="${HARNESS_SEED:-42}"

# ---- 验证服务端口(避免与预览端口 5000 冲突) ----
export HARNESS_VERIFY_PORT="${HARNESS_VERIFY_PORT:-5060}"

# ---- 回归用例集(留空则回退到 constraints.json 的 run_cases → cases) ----
# 默认留空,统一由 constraints.json 的 run_cases 控制「实际运行哪些用例」;
# 如需临时覆盖,可 export HARNESS_CASES="education" 或多个用空格分隔。
export HARNESS_CASES="${HARNESS_CASES:-}"

# ---- 确定性复跑校验:1=每用例通过后复跑并比对产物哈希;0=关闭(省额度) ----
export HARNESS_DET_CHECK="${HARNESS_DET_CHECK:-1}"

# ---- 生成模式:real=调用 DeepSeek;sample=离线参考生成器(不烧额度,用于冒烟/CI) ----
export HARNESS_MODE="${HARNESS_MODE:-real}"

# ---- 验收标准来源(选项接口) ----
# fixed = catalog 门禁 verify.py,读 case.json 的 catalog 字段(列表+详情站)。
# spec  = Spec 门禁 verify_ac.py,读 cases/<case>/spec/acceptance.json 的 TC/AC,不认应用类型。
# auto  = 该用例有 spec/acceptance.json 就走 spec,否则回退 fixed。
#         默认:混合用例集(catalog + Spec 交互工具)按 case 自动分流,对现有 catalog 用例零影响。
# 可被环境变量 HARNESS_VERIFY_SOURCE 覆盖。
export HARNESS_VERIFY_SOURCE="${HARNESS_VERIFY_SOURCE:-auto}"

# 说明:密钥 DEEPSEEK_API_KEY 不放这里,统一从仓库根目录 .env 读取(已 gitignore)
