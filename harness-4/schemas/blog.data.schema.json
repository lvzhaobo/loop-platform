{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "blog data item",
  "type": "array",
  "minItems": 6,
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "author",
      "date",
      "summary",
      "content"
    ],
    "properties": {
      "id": {
        "type": "integer"
      },
      "title": {
        "type": "string",
        "maxLength": 60
      },
      "author": {
        "type": "string"
      },
      "date": {
        "type": "string"
      },
      "summary": {
        "type": "string",
        "maxLength": 120
      },
      "content": {
        "type": "string",
        "minLength": 200
      }
    }
  }
}