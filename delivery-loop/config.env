# delivery-loop 运行配置(编排层,非机密)。可被已导出的环境变量覆盖。
# 密钥(DEEPSEEK_API_KEY / GITHUB_TOKEN / JIRA_API_TOKEN ...)统一从仓库根 .env 读取,永不进此文件。

# ---- 需求来源(适配器) ----
# local=读本地 backlog.jsonl;feishu=读飞书云文档 docx;后续可扩展 github|jira|teambition|bitable
export HARNESS_BACKLOG_SOURCE="${HARNESS_BACKLOG_SOURCE:-local}"
export HARNESS_BACKLOG_FILE="${HARNESS_BACKLOG_FILE:-delivery-loop/backlog/backlog.jsonl}"

# ---- 飞书云文档来源(HARNESS_BACKLOG_SOURCE=feishu 时生效) ----
# 需求清单(非机密:文档 token/标题/可选 case 提示);凭证 FEISHU_APP_ID/SECRET 走仓库根 .env
export HARNESS_FEISHU_DOCS="${HARNESS_FEISHU_DOCS:-delivery-loop/backlog/feishu_docs.json}"
export HARNESS_FEISHU_STATE="${HARNESS_FEISHU_STATE:-delivery-loop/backlog/feishu_state.json}"

# ---- 传给 harness-4 引擎的生成模式 ----
# sample=离线参考生成器(零密钥,默认,用于跑通闭环);real=调用 DeepSeek(需 .env 里 DEEPSEEK_API_KEY)
export HARNESS_MODE="${HARNESS_MODE:-sample}"

# ---- L1 发布到 GitHub ----
# 1=产物通过后 git 提交并发布;0=不发布
export HARNESS_AUTOCOMMIT="${HARNESS_AUTOCOMMIT:-0}"
# 目标仓库(不含 token,不含 https://):如 github.com/lvzhaobo/loop-sample.git
export HARNESS_GIT_REMOTE="${HARNESS_GIT_REMOTE:-}"
# 子目录模式(非空时):应用放到仓库 <子目录>/ 下,推到 HARNESS_GIT_BRANCH。如 sample1
export HARNESS_GIT_SUBDIR="${HARNESS_GIT_SUBDIR:-}"
# B 方案(当前默认):1=每次发布自动新建 <前缀><N+1>/(如 sample7),不覆盖旧样例;0=用固定 HARNESS_GIT_SUBDIR
export HARNESS_GIT_SUBDIR_AUTO="${HARNESS_GIT_SUBDIR_AUTO:-1}"
export HARNESS_GIT_SUBDIR_PREFIX="${HARNESS_GIT_SUBDIR_PREFIX:-sample}"
# 每个样例对外端口 = 端口基数 + N(sample1→1001)。ECS 安全组需放行该段(如 1001-1099)
export HARNESS_PORT_BASE="${HARNESS_PORT_BASE:-1000}"
# 子目录模式的目标分支(默认 main)
export HARNESS_GIT_BRANCH="${HARNESS_GIT_BRANCH:-main}"
# 分支模式(未设 HARNESS_GIT_SUBDIR 时)的分支前缀:<前缀>/<任务id>-<时间戳>
export HARNESS_GIT_BRANCH_PREFIX="${HARNESS_GIT_BRANCH_PREFIX:-harness}"
# 1=真实推送到远端(需 GITHUB_TOKEN);0=仅本地提交(无密钥自测)
export HARNESS_GIT_PUSH="${HARNESS_GIT_PUSH:-1}"

# ---- L4 部署到阿里云 ECS(拉取式:ECS 侧 git 拉取后运行) ----
# 1=推送成功后 SSH 到 ECS 部署;0=不部署
export ECS_DEPLOY="${ECS_DEPLOY:-0}"
# ECS 公网 IP / SSH 用户 / SSH 端口(密码 ECS_SSH_PASSWORD 走仓库根 .env)
export ECS_HOST="${ECS_HOST:-}"
export ECS_SSH_USER="${ECS_SSH_USER:-root}"
export ECS_SSH_PORT="${ECS_SSH_PORT:-22}"
# ECS 上代码存放根目录 / 应用对外端口(避开已有服务,默认 1001)
export ECS_REMOTE_DIR="${ECS_REMOTE_DIR:-~/apps}"
export ECS_APP_PORT="${ECS_APP_PORT:-1001}"
# B 方案:保留最近 N 个样例进程存活(其余停进程腾端口,目录仍留 git)
export ECS_RETAIN="${ECS_RETAIN:-5}"

# ---- 单批最多处理多少条 pending 任务(0=不限) ----
export HARNESS_MAX_TASKS="${HARNESS_MAX_TASKS:-0}"

# ================= 自动触发器 trigger/(把"人工启动的批处理"升级为"自驱动 Loop")=================
# trigger/ 是纯外挂:只在后台周期性/受事件驱动地调用 run_backlog.sh,
# 不改 orchestrator.py、不碰 harness-4/5。补上它,delivery-loop 才真正跨入 Loop Engineering。

# ---- 轮询式触发 trigger/poll.sh(Polling-based:系统主动扫描)----
# 两次扫描之间的间隔秒数。守护进程模式下每隔这么久跑一批需求池。
export HARNESS_TRIGGER_INTERVAL="${HARNESS_TRIGGER_INTERVAL:-300}"

# ---- 事件式触发 trigger/webhook.py(Event-driven:外部事件推送)----
# webhook 监听端口;向 http://127.0.0.1:<端口>/trigger 发 POST 即触发一批。
export HARNESS_TRIGGER_PORT="${HARNESS_TRIGGER_PORT:-8787}"
# webhook 只绑本机回环,避免误暴露到公网。要对外需自行套反向代理并加鉴权。
export HARNESS_TRIGGER_HOST="${HARNESS_TRIGGER_HOST:-127.0.0.1}"
# 共享密钥(可选):设了之后,webhook 请求头需带 X-Trigger-Token: <该值> 才放行。
# 真实密钥建议写仓库根 .env 里的 HARNESS_TRIGGER_TOKEN=xxx(已 gitignore),此处留空=不校验。
export HARNESS_TRIGGER_TOKEN="${HARNESS_TRIGGER_TOKEN:-}"
