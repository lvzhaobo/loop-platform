# ============================================
#  唯一配置点 —— 三个装置共用
#  复制本文件为 config.env 后填入你的 key
# ============================================

# --- 模型 ---
DEEPSEEK_API_KEY=sk-在这里填你自己的
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 工作区（agent 只能碰这里面的文件） ---
# 相对 demo/ 目录。默认指向番茄钟工程；
# 改成 . 就能演示「agent 改自己白名单」（harness 也在工作区内）
WORKSPACE=shared/fixture/pomodoro

# --- 策略 ---
# 同一处最多重试几次，超过就升级给人（R1 → R2/R3）
MAX_RETRIES=2
# 最多走多少个 step（防死循环）
MAX_STEPS=30
# 是否需要人工审批（true = 写文件/跑命令前问一句）
NEED_APPROVAL=true
# 单条命令超时（秒）
CMD_TIMEOUT=120

# --- 无 key 也能跑：mock 模式用固定脚本模拟模型 ---
# true 时不调用真实 API，只验证 loop / 闸门 / 留痕是否工作
MOCK=false
