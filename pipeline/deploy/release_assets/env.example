# 环境变量模板 —— 复制为 .env 后填入你自己的值(.env 已被 .gitignore,切勿提交)
# 用法:  cp .env.example .env  然后逐项填写

# ============ LLM(DeepSeek)============ 生成/编译必需
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ GitHub(推送产物样例)============ 需要"推产物"时必需
# 建一个自己的空仓当"样例产物仓",产物会以 sample1/ sample2/ ... 推进去
GITHUB_TOKEN=ghp_你的PAT_需repo写权限
# 覆盖平台内置默认样例仓(务必换成你自己的,否则会尝试推到别人的仓)
HARNESS_GIT_REMOTE=github.com/你的账号/你的样例仓.git

# ============ 飞书 / Lark(读需求文档)============ 用飞书当需求源时才需要
# 飞书开放平台建"企业自建应用",授予 docx/wiki 读权限,并把应用加进你的知识库
FEISHU_APP_ID=cli_你的appid
FEISHU_APP_SECRET=你的appsecret

# ============ ECS / 服务器(直传部署)============ 需要部署到服务器时才需要
ECS_HOST=你的服务器IP
ECS_SSH_USER=root
ECS_SSH_PORT=22
ECS_SSH_PASSWORD=你的SSH密码
