# ============================================================
#  loop-platform 环境变量模板  ——  复制为仓库根 .env 后填入真实值
#  cp .env.example .env   然后编辑 .env（.env 已被 .gitignore 忽略，永不提交）
#  所有密钥仅存于本机 .env / CI Secrets / 服务器环境变量，绝不写进代码或 config.env
# ============================================================

# ---- DeepSeek（real 模式生成用）----
export DEEPSEEK_API_KEY="sk-your-key-here"
export DEEPSEEK_BASE_URL="https://api.deepseek.com"
export DEEPSEEK_MODEL="deepseek-chat"

# ---- 飞书开放平台（feishu 需求来源用）----
export FEISHU_APP_ID="cli_xxxxxxxxxxxx"
export FEISHU_APP_SECRET="your-app-secret"

# ---- GitHub（发布到 loop-sample 用；细粒度 PAT，最小权限）----
# 需要：Contents(write) + Workflows(write)；建仓另需 Administration(write)
export GITHUB_TOKEN="github_pat_xxx_or_ghp_xxx"

# ---- 阿里云 ECS（部署用）----
export ECS_SSH_PASSWORD="your-ecs-ssh-password"

# ---- 触发器鉴权（webhook 对外时用，可留空=不校验）----
export HARNESS_TRIGGER_TOKEN=""
