# ============================================================
# Loop 平台环境配置模板
# 用法: cp .env.example .env 后填入真实值。.env 已被 .gitignore 排除，禁止提交。
# 密钥统一从本文件读取(loop/config.env 只放开关默认值，不放密钥)。
# ============================================================

# --- LLM(DeepSeek API，Maker 生成代码用) ---
export DEEPSEEK_API_KEY=""
export DEEPSEEK_BASE_URL="https://api.deepseek.com"
export DEEPSEEK_MODEL="deepseek-chat"

# --- 飞书(需求接入 adapters/feishu_adapter.py，可选) ---
export FEISHU_APP_ID=""
export FEISHU_APP_SECRET=""

# --- GitHub(产物推送 pipeline/publisher.py) ---
export GITHUB_TOKEN=""

# --- ECS(拉取式部署 pipeline/deployer.py) ---
export ECS_SSH_PASSWORD=""
export ECS_HOST=""

# --- GitHub 产物仓库(推送 + ECS 拉取式部署用，与 loop-studio.service 保持一致) ---
export HARNESS_GIT_REMOTE="github.com/<owner>/<sample-repo>.git"
export HARNESS_GIT_SUBDIR_AUTO="1"
