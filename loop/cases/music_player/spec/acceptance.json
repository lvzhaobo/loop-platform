{
  "name": "music_player",
  "ready_route": "/api/health",
  "acceptance": [
    {
      "id": "TC-INFRA-01",
      "type": "file_exists",
      "file": "app.py",
      "desc": "主入口文件存在"
    },
    {
      "id": "TC-INFRA-02",
      "type": "text_contains",
      "file": "requirements.txt",
      "needle": "flask",
      "desc": "依赖文件包含 Flask"
    },
    {
      "id": "TC-INFRA-03",
      "type": "text_contains",
      "file": "README.md",
      "needle": "音乐播放器",
      "desc": "README 包含项目名称"
    },
    {
      "id": "TC-HEALTH-01",
      "type": "http_status",
      "route": "/api/health",
      "expect": 200,
      "desc": "健康检查接口返回 200"
    },
    {
      "id": "TC-SETTINGS-01",
      "type": "http_body_contains",
      "route": "/api/settings",
      "needle": "theme",
      "desc": "设置接口返回包含 theme 字段"
    },
    {
      "id": "TC-PLAYBACK-01",
      "type": "http_status",
      "route": "/api/playback/state",
      "expect": 200,
      "desc": "获取播放状态成功"
    },
    {
      "id": "TC-VOLUME-MIN",
      "type": "http_json_min",
      "route": "/api/playback/state",
      "min": 0,
      "desc": "播放状态中的音量值至少为 0"
    },
    {
      "id": "TC-MANUAL-01",
      "type": "manual",
      "desc": "深色主题视觉检查：背景色 #121212，无眩光，手动验证"
    }
  ]
}